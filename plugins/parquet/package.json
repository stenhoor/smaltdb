{
  "name": "@smaltdb/parquet",
  "version": "0.9.0",
  "description": "Parquet format for smaltdb external tables and read_parquet()",
  "keywords": [
    "smaltdb",
    "parquet",
    "sql"
  ],
  "author": "stenhoor",
  "license": "MIT",
  "homepage": "https://github.com/stenhoor/smaltdb#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stenhoor/smaltdb.git",
    "directory": "plugins/parquet"
  },
  "bugs": {
    "url": "https://github.com/stenhoor/smaltdb/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../scripts/build-plugin.mjs",
    "prepublishOnly": "npm --prefix ../.. run build"
  },
  "dependencies": {
    "hyparquet": "1.31.4"
  },
  "peerDependencies": {
    "hyparquet-compressors": "^1.1.2",
    "smaltdb": ">=0.9.0 <0.10.0"
  },
  "peerDependenciesMeta": {
    "hyparquet-compressors": {
      "optional": true
    },
    "smaltdb": {
      "optional": true
    }
  }
}
