{
  "name": "@smaltdb/io",
  "version": "0.9.0",
  "description": "CSV, TSV and JSON formats, read_csv() / read_json(), and CSV/JSON import and export for smaltdb",
  "keywords": [
    "smaltdb",
    "csv",
    "json",
    "ndjson",
    "sql"
  ],
  "author": "stenhoor",
  "license": "MIT",
  "homepage": "https://github.com/stenhoor/smaltdb#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stenhoor/smaltdb.git",
    "directory": "plugins/io"
  },
  "bugs": {
    "url": "https://github.com/stenhoor/smaltdb/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../scripts/build-plugin.mjs",
    "prepublishOnly": "npm --prefix ../.. run build"
  },
  "peerDependencies": {
    "smaltdb": ">=0.9.0 <0.10.0"
  },
  "peerDependenciesMeta": {
    "smaltdb": {
      "optional": true
    }
  }
}
