{
  "name": "smaltdb",
  "version": "0.9.0",
  "description": "Fast embedded SQL database engine for browsers (OPFS + Web Workers)",
  "keywords": [
    "sql",
    "database",
    "sqlite",
    "opfs",
    "web-worker",
    "browser",
    "embedded",
    "indexeddb-alternative",
    "parquet",
    "csv"
  ],
  "author": "stenhoor",
  "homepage": "https://github.com/stenhoor/smaltdb#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stenhoor/smaltdb.git"
  },
  "bugs": {
    "url": "https://github.com/stenhoor/smaltdb/issues"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "node scripts/build.mjs && node test/browser/run.mjs",
    "slt": "esbuild test/slt/run.ts --bundle --platform=node --format=esm --outfile=.cache/slt-run.mjs --log-level=warning && node .cache/slt-run.mjs",
    "bench": "node bench/run-node.mjs",
    "bench:browser": "node bench/browser/run.mjs",
    "check": "npm run typecheck && npm test",
    "build": "node scripts/build.mjs && npm run build:types && npm run build --workspaces",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepublishOnly": "npm run typecheck && npm test && node scripts/build.mjs --minify && npm run build:types",
    "build:types": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@duckdb/duckdb-wasm": "^1.33.1-dev57.0",
    "@electric-sql/pglite": "^0.5.14",
    "@sqlite.org/sqlite-wasm": "^3.54.1-build1",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.2",
    "hyparquet-compressors": "1.1.2",
    "typescript": "5.9",
    "vitepress": "1.6.4",
    "vitest": "^5.0.5"
  },
  "exports": {
    ".": {
      "types": "./dist/types/client/index.d.ts",
      "default": "./dist/smaltdb.js"
    },
    "./engine": {
      "types": "./dist/types/engine/index.d.ts",
      "default": "./dist/engine.js"
    },
    "./worker-runtime": {
      "types": "./dist/types/engine/worker-runtime.d.ts",
      "default": "./dist/worker-runtime.js"
    },
    "./worker": "./dist/smaltdb-worker.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "types": "./dist/types/client/index.d.ts",
  "workspaces": [
    "plugins/*"
  ]
}
